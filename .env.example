# Drizzle / better-sqlite3 database filepath:
# Make sure this is an absolute path in production
# use and do not put the `file:` prefix for it!
DATABASE_URL=local.db

ORIGIN=""
ORIGIN_DEV="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CLIENT_ID_DEV=""
GITHUB_CLIENT_SECRET_DEV=""
