{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices", "config:js-app"],
	"schedule": ["* 0-3 * * *"],
	"packageRules": [
		{
			"groupName": "Production dependencies",
			"matchDepTypes": ["dependencies"]
		},
		{
			"groupName": "Non-major docker or workflow dependencies",
			"matchDatasources": ["docker", "github-digest", "github-runners", "github-tags"]
			"matchDepTypes": ["dependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
		},
		{
			"groupName": "Non-major development dependencies",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"automergeType": "branch"
		},
		{
			"groupName": "Major development dependencies",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["major"]
		},
		{
			"matchUpdateTypes": ["digest"],
			"automerge": true,
			"automergeType": "branch"
		}
	],
	"vulnerabilityAlerts": {
		"enabled": true,
		"automerge": true
	},
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	}
}
