{
	"name": "terminal-homepage",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"postinstall": "if [ -e scripts/ ]; then npx tsx scripts/download-font.ts; fi; exit 0",
		"predev": "npm run-script db:init",
		"dev": "vite dev",
		"prebuild": "npm run-script db:init",
		"build": "vite build",
		"postbuild": "npm run-script postbuild:install && npm run-script postbuild:prompt",
		"postbuild:install": "cp package.json ./build/ && cp package-lock.json ./build/ && npm ci --omit dev --prefix ./build/",
		"postbuild:prompt": "read -p \"Do you want to run prod now? (y/N): \" resp && [[ $resp =~ ^[Yy](es)?$ ]] && npm run-script prod; exit 0",
		"prod": "NODE_ENV=production exec node --env-file=.env ./build/",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:init": "if [ ! -f data/local.db ]; then read -p \"Database not found. Initialize now? (y/N): \" resp; [[ $resp =~ ^[Yy](es)?$ ]] && npm run-script db:push; fi; exit 0",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "npx @better-auth/cli generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@battlefieldduck/xterm-svelte": "2.3.0",
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "25.9.5",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/xterm": "6.0.0",
		"better-auth": "1.7.2",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.12",
		"typescript": "7.0.2",
		"typescript-eslint": "8.68.0",
		"vite": "8.2.2"
	},
	"dependencies": {
		"better-sqlite3": "12.11.1",
		"winston": "3.19.0"
	}
}
